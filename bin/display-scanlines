#!/usr/bin/env bash
# Display Scanlines — CRT scanline shader control.
#
# Usage:
#   display-scanlines off | light | heavy
#   display-scanlines cycle      # off -> light -> heavy -> off
#   display-scanlines status     # {"level":"light","enabled":true,...}
#
# The two active levels share one shader body (shaders/crt.body.glsl); this
# script composes it with a `#define CRT_LEVEL n` preamble into a generated
# file, so the levels can never drift out of sync. The shader itself discovers
# each output's physical resolution at runtime with textureSize(), so there is
# nothing resolution-specific to compute here and nothing to regenerate on
# hotplug, mode change, or scale change.
#
# Applies immediately via `hyprctl eval` and persists across Hyprland reloads
# and logins via a flag module in Omarchy's toggles directory.

set -euo pipefail

plugin_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
body="$plugin_dir/shaders/crt.body.glsl"

state_home=${XDG_STATE_HOME:-$HOME/.local/state}
gen_dir="$state_home/omarchy/display-scanlines"
toggle_file="$state_home/omarchy/toggles/hypr/zz-display-scanlines.lua"

LEVELS=(off light heavy)

level_number() {
  case $1 in
  light) echo 1 ;;
  heavy) echo 2 ;;
  *) echo 0 ;;
  esac
}

# "medium" was removed. Anything still pointing at it — a live Hyprland shader
# path, the persisted toggle file, or a stale command — resolves to heavy so it
# degrades to the nearest surviving level instead of a missing-shader error.
normalize_level() {
  if [[ $1 == medium ]]; then echo heavy; else echo "$1"; fi
}

lua_quote() {
  # Single-quoted Lua string with embedded quotes/backslashes escaped.
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\'/\\\'}
  printf "'%s'" "$s"
}

shader_path_for() {
  printf '%s/crt-%s.frag\n' "$gen_dir" "$1"
}

current_shader() {
  hyprctl getoption decoration:screen_shader 2>/dev/null |
    sed -n 's/^str:[[:space:]]*//p' | head -n1
}

# Current level is derived from the shader Hyprland actually has loaded, so an
# external change or a fresh login reports honestly.
current_level() {
  local cur
  cur=$(current_shader)
  [[ -z $cur ]] && {
    echo off
    return
  }
  local lvl
  for lvl in light heavy; do
    if [[ $cur == "$(shader_path_for "$lvl")" ]]; then
      echo "$lvl"
      return
    fi
  done
  # A session still running the removed medium shader reports as heavy, so
  # `cycle` advances from the right place instead of restarting at off.
  if [[ $cur == "$(shader_path_for medium)" ]]; then
    echo heavy
    return
  fi
  echo off
}

# Compose the level's shader from the shared body. Regenerated on every apply
# so edits to the body take effect without a manual cleanup step.
generate() {
  local level=$1 num out
  num=$(level_number "$level")
  out=$(shader_path_for "$level")

  if [[ ! -f $body ]]; then
    echo "display-scanlines: shader body not found: $body" >&2
    exit 1
  fi

  mkdir -p "$gen_dir"
  {
    echo "#version 300 es"
    echo "// GENERATED by display-scanlines from shaders/crt.body.glsl — do not edit."
    echo "// Edit the body instead; this file is rebuilt on every apply."
    echo "#define CRT_LEVEL $num"
    cat "$body"
  } >"$out.tmp"
  mv -f "$out.tmp" "$out"

  printf '%s\n' "$out"
}

apply_shader() {
  hyprctl eval "hl.config({ decoration = { screen_shader = $(lua_quote "$1") } })" >/dev/null
}

set_level() {
  local level
  level=$(normalize_level "$1")

  if [[ $level == off ]]; then
    rm -f "$toggle_file"
    apply_shader ""
    return
  fi

  local shader
  shader=$(generate "$level")

  mkdir -p "$(dirname "$toggle_file")"
  cat >"$toggle_file" <<EOF
-- Managed by display-scanlines (level: $level).
-- Run \`display-scanlines off\` to disable, or delete this file.
hl.config({ decoration = { screen_shader = $(lua_quote "$shader") } })
EOF

  apply_shader "$shader"
}

cycle() {
  local cur next i
  cur=$(current_level)
  for i in "${!LEVELS[@]}"; do
    if [[ ${LEVELS[$i]} == "$cur" ]]; then
      next=${LEVELS[$(((i + 1) % ${#LEVELS[@]}))]}
      set_level "$next"
      printf '%s\n' "$next"
      return
    fi
  done
  set_level light
  echo light
}

status_json() {
  local level enabled
  level=$(current_level)
  if [[ $level == off ]]; then enabled=false; else enabled=true; fi

  if command -v jq >/dev/null 2>&1; then
    jq -cn --arg level "$level" --argjson enabled "$enabled" \
      --argjson n "$(level_number "$level")" \
      '{level: $level, levelNumber: $n, enabled: $enabled}'
  else
    printf '{"level":"%s","levelNumber":%s,"enabled":%s}\n' \
      "$level" "$(level_number "$level")" "$enabled"
  fi
}

case ${1:-cycle} in
off | light | heavy) set_level "$1" ;;
medium) set_level heavy ;; # removed level; nearest surviving match
cycle | toggle) cycle ;;
status | --status) status_json ;;
*)
  echo "usage: display-scanlines [off|light|heavy|cycle|status]" >&2
  exit 2
  ;;
esac
