#!/usr/bin/env bash
# Display Scanlines — independent power and preset control.
#
# Usage:
#   display-scanlines on | off | toggle
#   display-scanlines light | heavy      # select preset; preserve power state
#   display-scanlines status             # {"level":"light","enabled":false,...}
#
# Light/Heavy is persistent preference, independent of enabled/disabled state.
# Selecting a preset while off does not enable the shader; the next `on` or
# `toggle` reapplies that preset. Selecting a preset while on applies it now.
#
# The two presets share one shader body (shaders/crt.body.glsl). This script
# prepends a CRT_LEVEL define into a generated file. The shader discovers each
# output's physical resolution at runtime, so display hotplug, resolution, and
# scale changes require no regeneration.

set -euo pipefail

plugin_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
body="$plugin_dir/shaders/crt.body.glsl"

state_home=${XDG_STATE_HOME:-$HOME/.local/state}
gen_dir="$state_home/omarchy/display-scanlines"
preset_file="$gen_dir/preset"
toggle_file="$state_home/omarchy/toggles/hypr/zz-display-scanlines.lua"

level_number() {
  case $1 in
  light) echo 1 ;;
  heavy) echo 2 ;;
  *) return 1 ;;
  esac
}

normalize_level() {
  case $1 in
  light | heavy) echo "$1" ;;
  medium) echo heavy ;; # removed preset; nearest surviving match
  *) return 1 ;;
  esac
}

lua_quote() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\'/\\\'}
  printf "'%s'" "$s"
}

shader_path_for() {
  printf '%s/crt-%s.frag\n' "$gen_dir" "$1"
}

current_shader() {
  hyprctl getoption decoration:screen_shader 2>/dev/null |
    sed -n 's/^str:[[:space:]]*//p' | head -n1
}

preset_from_shader() {
  local cur=${1:-$(current_shader)}
  case $cur in
  "$(shader_path_for light)") echo light ;;
  "$(shader_path_for heavy)" | "$(shader_path_for medium)") echo heavy ;;
  *) return 1 ;;
  esac
}

# Read persisted preference. For upgrades from the old combined-state design,
# recover the active preset from Hyprland or the toggle module before falling
# back to Light.
read_preset() {
  local level=""

  if [[ -f $preset_file ]]; then
    level=$(normalize_level "$(tr -d '[:space:]' <"$preset_file")" 2>/dev/null || true)
  fi

  if [[ -z $level ]]; then
    level=$(preset_from_shader 2>/dev/null || true)
  fi

  if [[ -z $level && -f $toggle_file ]]; then
    if grep -q 'crt-heavy\.frag\|crt-medium\.frag' "$toggle_file"; then
      level=heavy
    elif grep -q 'crt-light\.frag' "$toggle_file"; then
      level=light
    fi
  fi

  printf '%s\n' "${level:-light}"
}

save_preset() {
  local level
  level=$(normalize_level "$1")
  mkdir -p "$gen_dir"
  printf '%s\n' "$level" >"$preset_file.tmp"
  mv -f "$preset_file.tmp" "$preset_file"
  rm -f "$gen_dir/crt-medium.frag"
}

is_enabled() {
  preset_from_shader >/dev/null 2>&1
}

# Compose the selected preset's shader from the shared body. Regenerated on
# every apply so source edits land without a cleanup step.
generate() {
  local level num out
  level=$(normalize_level "$1")
  num=$(level_number "$level")
  out=$(shader_path_for "$level")

  if [[ ! -f $body ]]; then
    echo "display-scanlines: shader body not found: $body" >&2
    exit 1
  fi

  mkdir -p "$gen_dir"
  {
    echo "#version 300 es"
    echo "// GENERATED by display-scanlines from shaders/crt.body.glsl — do not edit."
    echo "// Edit the body instead; this file is rebuilt whenever applied."
    echo "#define CRT_LEVEL $num"
    cat "$body"
  } >"$out.tmp"
  mv -f "$out.tmp" "$out"

  printf '%s\n' "$out"
}

apply_shader() {
  hyprctl eval "hl.config({ decoration = { screen_shader = $(lua_quote "$1") } })" >/dev/null
}

write_toggle() {
  local level=$1 shader=$2
  mkdir -p "$(dirname "$toggle_file")"
  cat >"$toggle_file" <<EOF
-- Managed by display-scanlines (preset: $level).
-- Run \`display-scanlines off\` to disable; preset preference remains saved.
hl.config({ decoration = { screen_shader = $(lua_quote "$shader") } })
EOF
}

enable_shader() {
  local level shader
  level=$(read_preset)
  save_preset "$level"
  shader=$(generate "$level")
  write_toggle "$level" "$shader"
  apply_shader "$shader"
}

disable_shader() {
  # Persist the active preset before unloading when upgrading from an old state
  # that had no separate preset file.
  save_preset "$(read_preset)"
  rm -f "$toggle_file"
  apply_shader ""
}

set_preset() {
  local level enabled=false shader
  level=$(normalize_level "$1")
  if is_enabled; then enabled=true; fi

  save_preset "$level"
  shader=$(generate "$level")

  if [[ $enabled == true ]]; then
    write_toggle "$level" "$shader"
    apply_shader "$shader"
  fi
}

toggle_shader() {
  if is_enabled; then
    disable_shader
    echo off
  else
    enable_shader
    echo on
  fi
}

status_json() {
  local level enabled=false
  level=$(read_preset)
  if is_enabled; then enabled=true; fi

  if command -v jq >/dev/null 2>&1; then
    jq -cn --arg level "$level" --argjson enabled "$enabled" \
      --argjson n "$(level_number "$level")" \
      '{level: $level, levelNumber: $n, enabled: $enabled}'
  else
    printf '{"level":"%s","levelNumber":%s,"enabled":%s}\n' \
      "$level" "$(level_number "$level")" "$enabled"
  fi
}

case ${1:-toggle} in
on) enable_shader ;;
off) disable_shader ;;
toggle | cycle) toggle_shader ;; # cycle retained as a backwards-compatible alias
light | heavy) set_preset "$1" ;;
medium) set_preset heavy ;; # removed preset; nearest surviving match
status | --status) status_json ;;
*)
  echo "usage: display-scanlines [on|off|toggle|light|heavy|status]" >&2
  exit 2
  ;;
esac
